DATABASE_URL="postgresql://user:password@localhost:5432/projects_db"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Must exactly match the app origin in each environment (protocol + host + port)
# Examples: http://localhost:3000, https://projects.example.com
NEXTAUTH_URL="http://localhost:3000"
# Photon OIDC. Register the client under /admin/oauth-clients on tihlde.org
# (super admin) and set the redirect URI to <app origin>/api/auth/callback/photon.
PHOTON_CLIENT_ID="tihlde_..."
PHOTON_CLIENT_SECRET="tihlde_cs_..."
# Only override when pointing at a local Photon instance.
# PHOTON_ISSUER="http://localhost:4000/api/auth"
GITHUB_TOKEN="ghp_your_personal_access_token"
